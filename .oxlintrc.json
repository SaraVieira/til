{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["src/routeTree.gen.ts", ".output/**", "drizzle/**"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/no-autofocus": "off"
  }
}
